NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/nest-react-auth
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Generate a real secret with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN_SECONDS=3600
# lax | strict | none (none requires HTTPS; only for cross-site deployments)
COOKIE_SAMESITE=lax

# Serve interactive API docs at /api/docs
SWAGGER_ENABLED=true
